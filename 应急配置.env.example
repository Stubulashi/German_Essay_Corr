# 应急版云端模型预设 · 模板(复制为「应急配置.env」后填入真实值)
# - 仅被「应急启动.bat / 应急启动.command」读取,以进程环境变量方式注入;
# - 不会写入 backend/.env,不影响设置中心与常规配置;
# - 建议权限:macOS 执行 chmod 600 应急配置.env;Windows 右键 属性→安全 仅保留当前用户;
# - 本文件(example)可提交;真实密钥文件「应急配置.env」已在 .gitignore 中忽略。

# ---- 识别位:阿里云百炼(DashScope)Qwen ----
OCR_PROVIDER=vlm_openai
OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OCR_API_KEY=sk-替换为你的百炼密钥
OCR_MODEL=qwen-vl-plus

# ---- 评分位:DeepSeek(练习卷命题 / 风格归纳自动复用) ----
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-替换为你的DeepSeek密钥
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_USE_REASONING=false
