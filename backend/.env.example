# =============================================================
# 德语教师端智能作文批改系统 - 环境配置示例
# 使用方式:复制本文件为 .env 并按需修改
# =============================================================

# ---------- 全局开关 ----------
# 默认管线:PIPELINE_A_LOCAL(本地 VLM) | PIPELINE_B_CLOUD(云端解耦)
DEFAULT_PIPELINE=PIPELINE_A_LOCAL
# 管线 A 网络错误/超时时,是否允许自动故障转移至管线 B
ALLOW_AUTO_FALLBACK=true
# 演示/开发模式:true 时不调用任何真实模型,返回样例数据(用于 UI 开发与验收)
MOCK_MODE=false

# ---------- 管线 A:本地 VLM(vLLM / Ollama,OpenAI 兼容端点) ----------
# vLLM 示例:http://127.0.0.1:8000/v1 ;Ollama 示例:http://127.0.0.1:11434/v1
LOCAL_VLM_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_VLM_API_KEY=sk-local
LOCAL_VLM_MODEL=/models/Qwen3.8-27B-Q4_K_M
# 本地推理较慢,默认 10 分钟超时(秒)
LOCAL_VLM_TIMEOUT=600

# ---------- 管线 B 步骤 1:视觉 / OCR ----------
# 纯本地 OCR 模式:true=识别完全本地(RapidOCR 离线 CPU,不调用任何云端/远程 OCR 端点;评分不变) / false=现有行为
LOCAL_OCR_ONLY=false
# OCR 提供者:vlm_openai(Qwen2.5-VL 等 OpenAI 兼容端点) | azure(Azure Computer Vision)
OCR_PROVIDER=vlm_openai
# --- vlm_openai 模式 ---
# 阿里云 DashScope 兼容模式示例:https://dashscope.aliyuncs.com/compatible-mode/v1
OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OCR_API_KEY=
OCR_MODEL=qwen2.5-vl-72b-instruct
OCR_TIMEOUT=120
# --- azure 模式 ---
AZURE_OCR_ENDPOINT=
AZURE_OCR_KEY=

# ---------- 管线 B 步骤 3:文本评分 LLM(DeepSeek) ----------
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
# 常规评分模型:deepseek-chat(DeepSeek-V3)
DEEPSEEK_MODEL=deepseek-chat
# 深度推理模型:deepseek-reasoner(DeepSeek-R1)
DEEPSEEK_REASONING_MODEL=deepseek-reasoner
DEEPSEEK_TIMEOUT=180

# ---------- 队列与存储 ----------
# 并发批改任务数
MAX_CONCURRENT_TASKS=2
# 数据库连接(默认 SQLite,位于 backend/data 目录);已引入 Alembic 迁移,升级应用会自动执行
DATABASE_URL=sqlite+aiosqlite:///./data/corrector.db
# 上传文件存储目录
UPLOAD_DIR=./data/uploads
# 服务监听端口
SERVER_PORT=8765
# 上传图片自动预处理:EXIF 方向纠正 / 去阴影 / 对比度增强 / 保守自动裁边(默认开启)
IMAGE_PREPROCESS=true
# 去阴影/光照均衡(手机拍照常见阴影;对均匀光照照片近似无影响,默认开启)
IMAGE_SHADOW_REMOVAL=true
# 灰度化(默认关闭;黑白打印稿可开启以减小体积、突出对比)
IMAGE_GRAYSCALE=false
# 单次上传文件数上限(含 ZIP 展开后的条目数)
MAX_BATCH_FILES=200
# 单次请求上传总量上限(MB,含 ZIP 压缩包本身)
MAX_UPLOAD_TOTAL_MB=500

# ---------- 设置中心扩展项(均可在设置中心图形化修改;此处为默认值参考) ----------
# 开发者模式:放开"开发者专属"配置项(数据库/目录/端口/并发等)
DEV_MODE=false
# 设置接口访问令牌:为空时仅本机回环可访问设置接口;远程管理需配置
SETTINGS_ADMIN_TOKEN=
# 启动时弹出「班级数据包选择」对话框(false = 直接进入工作台)
STARTUP_DATA_PICKER=true
# 评分使用深度推理模型(deepseek-reasoner);false 时用 DEEPSEEK_MODEL
DEEPSEEK_USE_REASONING=false
# OCR 转录异常检测与自愈(断词粘连/标签行/畸变词,自动重试与降级)
OCR_ANOMALY_ENABLED=true
OCR_ANOMALY_THRESHOLD=4
OCR_ANOMALY_MAX_RETRY=1
OCR_ANOMALY_FORCE_REVIEW=true
# 存档图片压缩(上传即压缩 + 设置中心"压缩存量图片"入口)
IMAGE_COMPRESS_ENABLED=true
IMAGE_COMPRESS_MAX_SIDE=2200
IMAGE_COMPRESS_QUALITY=88
# 标准答题卷(四角定位块)自动找平:仅标准卷命中时生效,普通照片原样保留
SHEET_ALIGN_ENABLED=true
# 上传后姓名预识别:提交后后台识别姓名/学号并即时展示(端点优先,本地 RapidOCR 兜底)
NAME_PRE_OCR_ENABLED=true
# 强制性姓名识别:选择/拖拽文件(含 ZIP/PDF)瞬间即用本地引擎识别姓名/年龄显示在文件列表(不落盘不建任务;默认关闭)
FORCE_NAME_RECOGNITION=false
# 手写识别增强档位:auto / light / medium / precise(auto=按本机核心与内存自动推荐;手动优先)
HANDWRITING_OCR_LEVEL=auto
# 界面外观档位:balanced=均衡(默认) / efficiency=极简(灰阶低配) / premium=高级
UI_PROFILE=balanced
# 教学与报告口径:及格线 / 工作台默认值 / 学生版显示项
SCORE_PASS_LINE=60
DEFAULT_GRADING_STANDARD=GAOKAO
DEFAULT_DETAIL_LEVEL=MEDIUM
STUDENT_REPORT_SHOW_SCORE=false
STUDENT_REPORT_SHOW_TIPS=true
# 学生数据加密总开关(请通过设置中心"数据加密"向导操作,勿手工修改)
ENCRYPTION_ENABLED=false

# ---------- 大模型超参数(自动适配;设置中心可逐项图形化调整) ----------
# 每个超参三态取值:auto=自动适配(默认,与历史行为一致) / omit=不发送该键(而非发 0/空/null) / 具体值
# 规则:基线=历史发送集(temperature=0.2 / stream=false / response_format=json_object);
#   可选参数(top_p / penalties / seed / stop / 自定义键)画像未声明时不发送;
#   内置模型画像(如 kimi-k3 不支持 temperature)+ 运行时"400 剔除学习"共同决定最终发送哪些参数;
#   端点返回 "Parameter 'xxx' is not supported" 时自动剔除该参数、重试一次并记录(设置中心"自动适配记录"可查看/清除)。
# 说明:response_format 可选 auto|json_object|text|omit;stream 可选 auto|false|omit(系统按非流式读取响应);
#   EXTRA_PARAMS 为自定义键值(分号分隔,值含英文逗号按数组解析,如 min_p=0.05;repetition_penalty=1.05)。
# 管线 A(本地 VLM):
LOCAL_VLM_TEMPERATURE=auto
LOCAL_VLM_TOP_P=auto
LOCAL_VLM_MAX_TOKENS=auto
LOCAL_VLM_PRESENCE_PENALTY=auto
LOCAL_VLM_FREQUENCY_PENALTY=auto
LOCAL_VLM_SEED=auto
LOCAL_VLM_STOP=auto
LOCAL_VLM_RESPONSE_FORMAT=auto
LOCAL_VLM_STREAM=auto
LOCAL_VLM_EXTRA_PARAMS=auto
# 管线 B · OCR(同上,前缀 OCR_):
OCR_TEMPERATURE=auto
OCR_TOP_P=auto
OCR_MAX_TOKENS=auto
OCR_PRESENCE_PENALTY=auto
OCR_FREQUENCY_PENALTY=auto
OCR_SEED=auto
OCR_STOP=auto
OCR_RESPONSE_FORMAT=auto
OCR_STREAM=auto
OCR_EXTRA_PARAMS=auto
# 管线 B · DeepSeek 评分(同上,前缀 DEEPSEEK_):
DEEPSEEK_TEMPERATURE=auto
DEEPSEEK_TOP_P=auto
DEEPSEEK_MAX_TOKENS=auto
DEEPSEEK_PRESENCE_PENALTY=auto
DEEPSEEK_FREQUENCY_PENALTY=auto
DEEPSEEK_SEED=auto
DEEPSEEK_STOP=auto
DEEPSEEK_RESPONSE_FORMAT=auto
DEEPSEEK_STREAM=auto
DEEPSEEK_EXTRA_PARAMS=auto

# ---------- 开发模式万能密码(仅开发环境兜底解锁;生产环境必须保持关闭) ----------
# 专用开关:需与 DEV_MODE=true 同时开启,且 DEV_MASTER_PASSWORD 为 ≥64 位十六进制长 Hash 才生效
DEV_MASTER_ENABLED=false
# 万能密码(长 Hash 串;仅本地 .env 注入,勿提交仓库、勿下发前端)
DEV_MASTER_PASSWORD=
